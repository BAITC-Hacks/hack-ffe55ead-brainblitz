# Copy to .env, edit locally, then explicitly load it before starting Uvicorn.
# The application does not load .env automatically. Never commit the real key.
AI_ENABLED=true
AI_API_KEY=
# Exact model ID from your team's access; must support Responses + Structured Outputs.
# No model is selected by default. Do not enter an invented model name.
AI_MODEL=
# Base path only: the adapter appends /responses.
AI_BASE_URL=https://api.openai.com/v1
# Total deadline for one provider request; no automatic retries.
AI_TIMEOUT_SECONDS=12
